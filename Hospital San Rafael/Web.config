<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de la aplicación Hospital Regional "San Rafael".
  Todo valor que pueda cambiar con el tiempo (rutas, reglas de negocio, seguridad)
  vive aquí para no tenerlo escrito directamente en el código.
  -->
<configuration>
  <appSettings>
    <!-- ===== Rutas de almacenamiento (App_Data NO es accesible desde el navegador) ===== -->
    <add key="RutaArchivoRegistros" value="~/App_Data/registros_medicamentos.xml" />
    <add key="RutaArchivoUsuarios" value="~/App_Data/usuarios.xml" />
    <add key="CarpetaLogs" value="~/App_Data/Logs" />

    <!-- ===== Reglas de negocio (RF-02). Cambiarlas aquí NO requiere recompilar ===== -->
    <add key="DosisMaximaMg" value="5000" />
    <add key="FrecuenciaMinimaDiaria" value="1" />
    <add key="FrecuenciaMaximaDiaria" value="24" />
    <add key="VentanaHorasPasado" value="24" />
    <add key="LongitudMaximaNombre" value="100" />

    <!-- ===== Seguridad del inicio de sesión ===== -->
    <add key="MaxIntentosFallidosLogin" value="5" />
    <add key="MinutosBloqueoLogin" value="15" />

    <!-- Los validadores de ASP.NET funcionan sin jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />

    <!-- No revelar la versión de ASP.NET y limitar el tamaño de las peticiones (KB) -->
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false" maxRequestLength="256" />

    <!-- Cultura del hospital: formatos de fecha y número en pantalla -->
    <globalization culture="es-MX" uiCulture="es-MX" requestEncoding="utf-8" responseEncoding="utf-8" />

    <!-- ===== Autenticación: inicio de sesión con formulario y cookie cifrada ===== -->
    <authentication mode="Forms">
      <forms name=".HSR_AUTH" loginUrl="~/Login.aspx" defaultUrl="~/RegistrarMedicamento.aspx"
             timeout="20" slidingExpiration="true" requireSSL="true" protection="All" cookieless="UseCookies" />
    </authentication>

    <!-- ===== Autorización: por defecto nadie anónimo entra a ninguna página ===== -->
    <authorization>
      <deny users="?" />
    </authorization>

    <!-- Cookies inaccesibles desde JavaScript y solo por HTTPS -->
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
    <sessionState cookieless="UseCookies" timeout="20" />

    <!-- ViewState cifrado (protege los datos capturados que viajan en la página) y validación de peticiones -->
    <pages viewStateEncryptionMode="Always" validateRequest="true" />

    <!-- Nunca mostrar al usuario el detalle técnico de un error; el detalle va al log -->
    <customErrors mode="On" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite" />

    <trace enabled="false" />
  </system.web>

  <!-- ===== Páginas y recursos públicos (no requieren sesión) ===== -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Estilos">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Script interno de ASP.NET que usan los validadores del lado del cliente -->
  <location path="WebResource.axd">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- ===== Solo el rol Enfermero puede registrar medicamentos ===== -->
  <location path="RegistrarMedicamento.aspx">
    <system.web>
      <authorization>
        <allow roles="Enfermero" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="RegistrarMedicamento.aspx" />
      </files>
    </defaultDocument>

    <!-- Encabezados de seguridad HTTP -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Content-Security-Policy" value="frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>
